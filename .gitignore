# What install.sh puts here: Python, arduino-cli, the fonts
.venv/
.tools/
tools/fonts/
# Builds (the page's engine, studio/web/build, is in git: no Emscripten needed)
/build/
__pycache__/
# Your projects and your Wi-Fi password — they stay on your computer, never in git
/projects/
studio/secrets/
wifi_net.h
# Copies of the firmware that was on your boards (Save its firmware) — yours only
studio/backups/
studio/videos/
# The Mac app's build (studio/app/build.sh)
studio/app/node_modules/
studio/app/dist/
studio/app/home.json
# Up to 2.0 all of these were inside PopkaStudio/ (the studio moves them by itself)
PopkaStudio/projects/
PopkaStudio/secrets/
PopkaStudio/backups/
PopkaStudio/videos/
PopkaStudio/app/
.DS_Store
